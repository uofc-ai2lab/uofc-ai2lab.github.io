<div class="grid-item">

  <div class="card hoverable person-card">

    <!-- Photo and basic information -->
    <div class="person-header">

      {% if person.img %}
        <div class="person-photo">
          {% include figure.liquid
            path=person.img
            alt="Portrait"
            class="img-fluid rounded-circle z-depth-0"
          %}
        </div>
      {% endif %}

      <div class="person-info">

        <h2 class="card-title person-name">
          {{ person.firstname }} {{ person.lastname }}
        </h2>

        {% if person.description %}
          <div class="person-position">
            {{ person.description }}
          </div>
        {% endif %}

        {% if person.department %}
          <div class="person-department">
            {{ person.department }}
          </div>
        {% endif %}

      </div>

    </div>

    <!-- Biography -->
    {% if person.content != blank %}
      <div class="card-body person-bio">
        {{ person.content }}
      </div>
    {% endif %}

    <!-- Social / Academic Links -->
    {% if person.redirect or person.linkedin_username or person.email or person.orcid_id or person.scholar_userid or person.github_username %}
      <div class="card-icons person-links">

        {% if person.redirect %}
          <a
            href="{{ person.redirect }}"
            target="_blank"
            rel="noopener noreferrer"
            title="Google Scholar"
            aria-label="Google Scholar"
          >
            <i class="icon mr-1 p-0 ai ai-google-scholar"></i>
          </a>

        {% elsif person.scholar_userid %}
          <a
            href="https://scholar.google.com/citations?user={{ person.scholar_userid }}"
            target="_blank"
            rel="noopener noreferrer"
            title="Google Scholar"
            aria-label="Google Scholar"
          >
            <i class="icon mr-1 p-0 ai ai-google-scholar"></i>
          </a>
        {% endif %}

        {% if person.linkedin_username %}
          <a
            href="https://www.linkedin.com/in/{{ person.linkedin_username }}"
            target="_blank"
            rel="noopener noreferrer"
            title="LinkedIn"
            aria-label="LinkedIn"
          >
            <i class="icon mr-1 p-0 fab fa-linkedin"></i>
          </a>
        {% endif %}

        {% if person.email %}
          <a
            href="mailto:{{ person.email | encode_email }}"
            title="Email"
            aria-label="Email"
          >
            <i class="icon mr-1 p-0 fas fa-envelope"></i>
          </a>
        {% endif %}

        {% if person.orcid_id %}
          <a
            href="https://orcid.org/{{ person.orcid_id }}"
            target="_blank"
            rel="noopener noreferrer"
            title="ORCID"
            aria-label="ORCID"
          >
            <i class="icon mr-1 p-0 ai ai-orcid"></i>
          </a>
        {% endif %}

        {% if person.github_username %}
          <a
            href="https://github.com/{{ person.github_username }}"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub"
            aria-label="GitHub"
          >
            <i class="icon mr-1 p-0 fab fa-github"></i>
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>

</div>
