<div class="ai2lab-news-cards">

  {% if site.news != blank %}

    {% assign news = site.news | sort: 'date' | reverse %}

    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news.size %}
    {% endif %}


    {% for item in news limit: news_limit %}

      <article class="ai2lab-news-card">


        {% if item.image %}

          <a
            href="{{ item.url | relative_url }}"
            class="ai2lab-news-image-link"
          >

            <img
              src="{{ item.image | relative_url }}"
              alt="{{ item.title }}"
              class="ai2lab-news-image"
              loading="lazy"
            >

          </a>

        {% endif %}


        <div class="ai2lab-news-card-content">

          <div class="ai2lab-news-date">
            {{ item.date | date: '%b %d, %Y' }}
          </div>


          {% if item.inline %}

            <div class="ai2lab-news-title">
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            </div>

          {% else %}

            <h3 class="ai2lab-news-title">

              <a href="{{ item.url | relative_url }}">
                {{ item.title }}
              </a>

            </h3>

          {% endif %}


          {% if item.description %}

            <p class="ai2lab-news-description">
              {{ item.description }}
            </p>

          {% elsif item.excerpt %}

            <p class="ai2lab-news-description">
              {{ item.excerpt | strip_html | truncate: 140 }}
            </p>

          {% endif %}

        </div>

      </article>

    {% endfor %}

  {% else %}

    <p>No news so far...</p>

  {% endif %}

</div>
