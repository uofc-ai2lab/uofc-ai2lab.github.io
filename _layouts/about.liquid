---
layout: default
---

<div class="post">

  {% unless page.hide_title %}
    <header class="post-header">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span>
          {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>

      {% if page.subtitle %}
        <p class="desc">{{ page.subtitle }}</p>
      {% endif %}
    </header>
  {% endunless %}


  <article>

    <!-- =========================================
         INTRODUCTION + PROFILE
         ========================================= -->

    <div class="ai2lab-home-top">

      <!-- Introduction -->

      <div class="ai2lab-introduction">

        {{ content }}

      </div>


      <!-- Logo + Address -->

      {% if page.profile %}

        <div class="ai2lab-profile">

          {% if page.profile.image %}

            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}

            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}

            {%
              include figure.liquid
              loading="eager"
              path=profile_image_path
              class=profile_image_class
              alt=page.profile.image
              cache_bust=true
            %}

          {% endif %}

          {% if page.profile.more_info %}

            <div class="more-info">
              {{ page.profile.more_info }}
            </div>

          {% endif %}

        </div>

      {% endif %}

    </div>


    <!-- =========================================
         MISSION & VISION + LATEST NEWS
         ========================================= -->

    <div class="ai2lab-info-grid">


      <!-- Mission & Vision -->

      <section class="ai2lab-mission">

        <h2>Mission &amp; Vision</h2>


        <div class="mission-item">

          <h3>Mission</h3>

          <p>
            To develop responsible, high-impact artificial intelligence
            and medical imaging research while providing an equitable,
            diverse, inclusive, and accessible environment where trainees
            can thrive.
          </p>

        </div>


        <div class="mission-item">

          <h3>Vision</h3>

          <p>
            To advance open, trustworthy, and clinically meaningful AI
            for healthcare while contributing to the broader research
            community through open science, education, and collaboration.
          </p>

        </div>


        <div class="mission-item">

          <h3>Open Science &amp; Community</h3>

          <p>
            Whenever possible, we make our data, code, and research
            resources publicly available. We also organize free workshops
            in programming, image analysis, and artificial intelligence
            to support broader participation in research and technology.
          </p>

        </div>

      </section>


      <!-- Latest News -->

      {% if page.announcements and page.announcements.enabled %}

        <section class="ai2lab-news">

          <div class="ai2lab-section-header">

            <h2>
              <a href="{{ '/news/' | relative_url }}">
                Latest News
              </a>
            </h2>

            <a
              class="ai2lab-view-all"
              href="{{ '/news/' | relative_url }}"
            >
              View all news →
            </a>

          </div>


          <div class="ai2lab-news-container">

            {% include news.liquid limit=true %}

          </div>

        </section>

      {% endif %}

    </div>


    <!-- =========================================
         YOUTUBE VIDEO
         ========================================= -->

    <section class="ai2lab-video">

      <h2>AI2Lab</h2>

      <div class="ai2lab-video-container">

        <iframe
          src="https://www.youtube.com/embed/Bq1Epvz_RH8"
          title="AI2Lab"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen>
        </iframe>

      </div>

    </section>


    <!-- =========================================
         SOCIAL LINKS
         ========================================= -->

    {% if page.social %}

      <div class="social">

        <div class="contact-icons">
          {% include social.liquid %}
        </div>

        <div class="contact-note">
          {{ site.contact_note }}
        </div>

      </div>

    {% endif %}


    <!-- =========================================
         NEWSLETTER
         ========================================= -->

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}

      {% include newsletter.liquid center=true %}

    {% endif %}

  </article>

</div>
